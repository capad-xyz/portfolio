{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capad-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "capad.fyi", "custom_domain": true },
    { "pattern": "www.capad.fyi", "custom_domain": true },
    // The product hostname. `custom_domain: true` makes wrangler create and own
    // the DNS record itself, which is why the pre-existing CNAME pointing this
    // name at capad-xyz.github.io MUST be deleted first — Cloudflare will not
    // let a Worker custom domain and a manual record hold the same hostname,
    // and the deploy fails rather than silently winning.
    { "pattern": "glyphmaps.capad.fyi", "custom_domain": true }
  ],
  // OpenNext's incremental cache: where revalidatePath/ISR write regenerated
  // pages. Without it, prerendered pages are frozen at build time and the
  // Sanity webhook can't actually refresh anything.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "2723bbf34f764ad8976016b186c6be88"
    }
  ],
  "observability": {
    "enabled": true
  }
}
